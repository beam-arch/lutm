# The guest RIL reads the modem simulator VSOCK port from this bootconfig
# property (rild_cuttlefish reads ro.boot.modem_simulator_ports and passes it to
# the reference-ril as -m). Cuttlefish declares the same type in
# device/google/cuttlefish/shared/sepolicy/vendor, which the virtio board config
# does not include, so it is declared here instead.
vendor_internal_prop(vendor_modem_simulator_ports_prop)
